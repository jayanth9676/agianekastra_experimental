# AGI/ASI Research Project - Environment Variables
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control (it's in .gitignore)

# ============================================================================
# REQUIRED API KEYS
# ============================================================================

# Exa API Key - For advanced web search and content extraction
# Get yours at: https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# Context7 API Key - Optional, for higher rate limits on doc search
# Get yours at: https://context7.com (free tier available without key)
CONTEXT7_API_KEY=your_context7_api_key_here

# GitHub Token - For repository management, code search, issues
# Create at: https://github.com/settings/tokens (scopes: repo, read:user)
GITHUB_TOKEN=your_github_token_here

# Semantic Scholar API Key - For academic paper search (200M+ papers)
# Get yours at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Kaggle Token - For ML competitions, datasets, notebooks
# Get yours at: https://www.kaggle.com/settings/account -> "Create New API Token"
# Download kaggle.json and extract the token, or use Kaggle MCP remotely
KAGGLE_TOKEN=your_kaggle_token_here

# Legacy Kaggle credentials (alternative method)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============================================================================
# OPTIONAL API KEYS
# ============================================================================

# Hugging Face Token - Only needed for gated/private models
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Neo4j Docker URL - For MCP Neo4j Memory server
NEO4J_URL=bolt://host.docker.internal:7687

# ============================================================================
# LOCAL DATABASE CONFIGURATION (No API keys needed)
# ============================================================================

# Neo4j Graph Database (auto-configured by docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=asi-memory-2026

# Qdrant Vector Database (optional, for embeddings)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Leave empty for local instance

# ============================================================================
# WORKSPACE CONFIGURATION
# ============================================================================

# MCP Workspace Directory (relative to project root)
WORKSPACE_DIR=./workspace

# Memory Storage Path (for MCP memory server)
MEMORY_FILE_PATH=./memory/knowledge_graph.jsonl

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Python environment
PYTHONPATH=.

# Disable tokenizers parallelism warning
TOKENIZERS_PARALLELISM=false

# ============================================================================
# SECURITY WARNING
# ============================================================================
# 
# 1. NEVER commit this file with real API keys to git
# 2. Keep your .env file secure and private
# 3. Rotate API keys regularly
# 4. Use environment-specific keys (dev/staging/prod)
# 5. Monitor API usage for unexpected activity
#
# To add to .gitignore:
#   echo ".env" >> .gitignore
#   echo "memory/" >> .gitignore
#   echo "workspace/" >> .gitignore
