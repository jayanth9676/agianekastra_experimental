{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${EXA_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./workspace"
      ],
      "enabled": true
    },
    "kaggle": {
      "type": "remote",
      "url": "https://www.kaggle.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${KAGGLE_TOKEN}"
      }
    },
    "neo4j-memory": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "--network",
        "asi-research-network",
        "-e",
        "NEO4J_URL=bolt://neo4j-asi-memory:7687",
        "-e",
        "NEO4J_USERNAME=neo4j",
        "-e",
        "NEO4J_PASSWORD=asi-memory-2026",
        "-e",
        "NEO4J_DATABASE=neo4j",
        "mcp/neo4j-memory:latest"
      ],
      "enabled": true
    },
    "AI-Research-Assistant": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@smithery/cli@latest",
        "run",
        "@hamid-vakilzadeh/mcpsemanticscholar"
      ],
      "enabled": true,
      "environment": {
        "SEMANTIC_SCHOLAR_API_KEY": "${SEMANTIC_SCHOLAR_API_KEY}",
        "SMITHERY_API_KEY": "${SMITHERY_API_KEY}"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "huggingface-official": {
      "type": "remote",
      "url": "https://huggingface.co/mcp",
      "headers": {
          "Authorization": "Bearer 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"
      }
    }
  }
}
